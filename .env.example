# Server Configuration
SERVER_PORT=8082

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_service_db
DB_USERNAME=itp
DB_PASSWORD=abcd
DB_URL=jdbc:postgresql://localhost:5432/inventory_service_db
HIBERNATE_DDL_AUTO=update

# Eureka Discovery Server
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=smart-dine-realm
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/smart-dine-realm
KEYCLOAK_JWK_URI=http://localhost:8080/realms/developersstack/protocol/openid-connect/certs
